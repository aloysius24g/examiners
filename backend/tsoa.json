{
  "entryFile": "src/server.ts",
  "noImplicitAdditionalProperties": "throw-on-extras",
  "controllerPathGlobs": ["src/**/*Controller.ts"],
  "spec": {
    "outputDirectory": "generated/tsoa/docs",
    "specVersion": 3,
    "securityDefinitions": {
      "type": "apikey",
      "name": "refreshToken", 
      "in": "cookie"
    }
  },
  "routes": {
    "routesDir": "generated/tsoa/routes"
  }
}
